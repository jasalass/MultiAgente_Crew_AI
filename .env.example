# Copiar a .env y completar las keys. El .env NUNCA se sube a git.
# Un bloque por modelo: LLM_API_KEY_<NOMBRE>, LLM_MODEL_<NOMBRE> y, si no es Groq, LLM_BASE_URL_<NOMBRE>.
# Opcionales por bloque: LLM_FAMILIA_<NOMBRE> (si no se deduce del modelo), LLM_REASONING_<NOMBRE>
# (low|medium|high, modelos de razonamiento) y LLM_MAX_TOKENS_<NOMBRE>.
# Un bloque con la key vacía se omite. Los límites son por cuenta y por modelo: keys de una misma
# cuenta comparten el límite de cada modelo.

# ===== Groq (URL por defecto de todos los bloques sin LLM_BASE_URL propia) =====
LLM_BASE_URL_GROQ=https://api.groq.com/openai/v1

# ===== Moderador (manager del Crew): bloques MODERADOR_<n>, todos con LLM_MODEL_MODERADOR =====
# Cada experto tiene su propio Crew y el Moderador rota entre estas keys (de cuentas distintas).
# Debe ser un modelo con llamadas a herramientas (las usa para delegar).
# Sin bloques MODERADOR_<n>, el Moderador usa el modelo de experto menos usado por el panel.
LLM_MODEL_MODERADOR=openai/gpt-oss-120b
# Groq corta la salida en 2048 tokens si no se indica; los modelos de razonamiento cortan el JSON.
LLM_MAX_TOKENS_MODERADOR=4000
LLM_REASONING_MODERADOR=low
LLM_API_KEY_MODERADOR_1=
LLM_API_KEY_MODERADOR_2=

# ===== Expertos: una familia de modelo distinta por bloque =====
# Qwen (Alibaba) - Groq. Límite de 1000 tokens de salida por minuto: no alcanza para un cuestionario
# completo (~1100). Dejar la key vacía salvo con cuestionarios chicos.
LLM_API_KEY_QWEN=
LLM_MODEL_QWEN=qwen/qwen3.8-27b

# GPT-OSS 20B (OpenAI) - Groq
LLM_API_KEY_GPT_OSS_20B=
LLM_MODEL_GPT_OSS_20B=openai/gpt-oss-20b
LLM_REASONING_GPT_OSS_20B=low
LLM_MAX_TOKENS_GPT_OSS_20B=4000          # Groq suma entrada + max_tokens contra 8000 tokens/min

# Gemini (Google AI Studio)
LLM_API_KEY_GEMINI=
LLM_BASE_URL_GEMINI=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_GEMINI=gemini-flash-latest
LLM_MAX_TOKENS_GEMINI=8000

# Gemma (Google AI Studio, misma key que Gemini; otra familia, pesos abiertos). ~2 min por respuesta.
LLM_API_KEY_GEMMA=
LLM_BASE_URL_GEMMA=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_GEMMA=gemma-4-31b-it
LLM_MAX_TOKENS_GEMMA=8000

# Mistral AI
LLM_API_KEY_MISTRAL=
LLM_BASE_URL_MISTRAL=https://api.mistral.ai/v1
LLM_MODEL_MISTRAL=mistral-small-latest

# OpenRouter (modelos ":free", límites bajos). Un modelo lento o con pocas peticiones diarias
# Los modelos :free cambian seguido (MiniMax M3.1 Flash dejó de ser gratis el 22-10-2026): revisar el catálogo.
# conviene marcarlo LLM_USO_<N>=puntual: si falla, esas llamadas las hace el Moderador.
LLM_API_KEY_NEMOTRON=
LLM_BASE_URL_NEMOTRON=https://openrouter.ai/api/v1
LLM_MODEL_NEMOTRON=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_REASONING_NEMOTRON=low
LLM_MAX_TOKENS_NEMOTRON=8000
LLM_USO_NEMOTRON=puntual                # no es experto: cuestionario y riesgos (1 llamada cada uno)
LLM_TIMEOUT_NEMOTRON=240

# ===== Conocimiento y memoria (RAG de la Ley 21.719, Asesor normativo) =====
# Embeddings para la búsqueda semántica. Sin estas variables se usan la key y la URL del bloque GEMINI.
# Sin ninguna key, la búsqueda cae a coincidencia de palabras (funciona, pero es más pobre).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDINGS_MODEL=gemini-embedding-001
# false = sin el Asesor normativo (análisis algo más rápido, sin ficha de contexto).
DELPHI_ASESOR=true

# ===== API (backend/api/main.py) =====
# DELPHI_SIMULADO=true usa LLM falsos: demo completa sin keys.
DELPHI_SIMULADO=false
# Expertos que responden a la vez en cada ronda (1 = de a uno) y segundos entre el inicio de
# uno y el siguiente (reparte el tráfico por minuto).
DELPHI_PARALELO=5
DELPHI_PAUSA=5

# ===== Frontend (Streamlit) =====
USE_MOCKS=false
API_BASE_URL=http://localhost:8000
