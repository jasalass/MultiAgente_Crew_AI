<mxfile host="app.diagrams.net" type="device"><diagram id="hoja1" name="1 · Visión general"><mxGraphModel dx="1700" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:22px'&gt;1 · Visión general: qué hace el sistema&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Recibe la descripción de un proyecto informático y un panel de expertos simulados con IA lo evalúa con el método Delphi. Se lee de izquierda a derecha.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1640" height="60" as="geometry"/></mxCell><mxCell id="n3" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="50" height="90" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Pantallas&lt;/b&gt;&lt;br&gt;(Streamlit)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="220" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Lo que ve la persona.&lt;/b&gt;&lt;br&gt;Describe el proyecto, elige el panel, sigue el análisis en vivo y revisa el veredicto, las decisiones y los riesgos." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="160" y="290" width="220" height="150" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;(FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="220" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;La recepción.&lt;/b&gt;&lt;br&gt;Recibe los pedidos de las pantallas, pone los análisis en cola (uno a la vez), los guarda en disco y entrega los resultados." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="220" height="150" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Motor Delphi&lt;/b&gt;&lt;br&gt;(código Python)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="220" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;El que manda.&lt;/b&gt;&lt;br&gt;Organiza las rondas, arma lo que recibe cada experto, calcula los números y aplica las reglas. Nada de esto lo decide la IA." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="220" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Equipo de IA&lt;/b&gt;&lt;br&gt;(CrewAI)&lt;br&gt;Moderador + 5 a 7 expertos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="220" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Los que opinan.&lt;/b&gt;&lt;br&gt;El Moderador escribe el cuestionario; cada experto (arquitectura, nube, seguridad…) responde con nota 1-5 y una justificación." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="220" height="150" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Proveedores de IA&lt;/b&gt;&lt;br&gt;Google · Groq" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="220" height="110" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;De dónde salen las IA.&lt;/b&gt;&lt;br&gt;Cada experto usa un modelo de una familia distinta (Gemini, Gemma, GPT-OSS) para que no piensen todos igual." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="220" height="150" as="geometry"/></mxCell><mxCell id="e14" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="inicia el análisis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="delega y recibe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="llama a los modelos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Resultado: el informe&lt;/b&gt;&lt;br&gt;⛔ / ⚠️ / ✅ veredicto de viabilidad · decisiones firmes, condicionadas o abiertas · riesgos por gravedad · un ADR por decisión" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=12;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="490" width="380" height="90" as="geometry"/></mxCell><mxCell id="e20" value="escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="n8" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="se muestra en" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="n19" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;¿Qué es el método Delphi?&lt;/b&gt; Una técnica para lograr acuerdo entre expertos: responden &lt;b&gt;por separado&lt;/b&gt; y &lt;b&gt;sin saber quién dijo qué&lt;/b&gt;, reciben un resumen anónimo del grupo y pueden reconsiderar. Se repite hasta que hay consenso. Así nadie arrastra a los demás por su cargo o personalidad." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="160" y="620" width="1420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hoja2" name="2 · Un análisis paso a paso"><mxGraphModel dx="1600" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:22px'&gt;2 · Un análisis paso a paso&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Cada columna es quién hace el paso. Verde: el programa con reglas fijas. Lila: una IA. Las notas amarillas explican las reglas.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1540" height="60" as="geometry"/></mxCell><mxCell id="n3" value="Persona" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="300" height="1050" as="geometry"/></mxCell><mxCell id="n4" value="Pantallas y API" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="300" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="Motor (código)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="300" height="1050" as="geometry"/></mxCell><mxCell id="n6" value="Asesor y Moderador (IA)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="300" height="1050" as="geometry"/></mxCell><mxCell id="n7" value="Expertos (IA)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="1270" y="90" width="300" height="1050" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;1.&lt;/b&gt; Describe el proyecto: objetivo, usuarios, plazo, presupuesto, equipo, restricciones y dudas (formulario o archivo .md)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="45" y="130" width="270" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;2.&lt;/b&gt; Sugiere el panel según el proyecto (5 del núcleo + hasta 2 opcionales); la persona lo ajusta y pulsa &lt;b&gt;Iniciar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="355" y="230" width="270" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;2b. Asesor normativo&lt;/b&gt; (2 agentes con herramientas): consulta la Ley 21.719 y la memoria de análisis anteriores; guarda una &lt;b&gt;ficha con citas&lt;/b&gt; (hoja 6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="975" y="210" width="270" height="95" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;3.&lt;/b&gt; Escribe el cuestionario: 3 a 5 &lt;b&gt;decisiones clave&lt;/b&gt; con sus alternativas y 6 a 10 &lt;b&gt;evaluaciones&lt;/b&gt;, considerando la ficha" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="975" y="330" width="270" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;4.&lt;/b&gt; Ajusta el cuestionario: recorta el exceso y &lt;b&gt;agrega siempre la pregunta de viabilidad global&lt;/b&gt;. Arma el enunciado de cada experto" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="665" y="430" width="270" height="90" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;5. Ronda:&lt;/b&gt; cada experto responde &lt;b&gt;en paralelo y sin ver a los demás&lt;/b&gt;: nota 1-5 y justificación por pregunta, más los riesgos que ve" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1285" y="540" width="270" height="95" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;6.&lt;/b&gt; Resume la ronda: &lt;b&gt;mediana&lt;/b&gt; (la nota del medio) e &lt;b&gt;IQR&lt;/b&gt; (qué tan dispersas). IQR ≤ 1 = consenso. Resume argumentos sin autor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="665" y="660" width="270" height="95" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;7. ¿Otra ronda?&lt;/b&gt;&lt;br&gt;mín. 2 · máx. 3&lt;br&gt;consenso ≥ 80 %" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="780" width="200" height="110" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;8.&lt;/b&gt; Agrupa los riesgos que señalaron los expertos y estima probabilidad e impacto" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="975" y="910" width="270" height="80" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;9.&lt;/b&gt; Calcula el &lt;b&gt;veredicto de viabilidad&lt;/b&gt;, clasifica cada decisión (firme / condicionada / abierta) y escribe el informe y los ADR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="665" y="1010" width="270" height="95" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;10.&lt;/b&gt; Muestra el resultado: veredicto, decisiones, riesgos por gravedad, convergencia y descargas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="355" y="1010" width="270" height="95" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="enunciado sellado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="respuestas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="sí: cada experto recibe su respuesta anterior y el resumen anónimo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n15" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;En vivo:&lt;/b&gt; cada respuesta aparece apenas llega, anónima (E1, E2…). Solo queda abierta la etapa en curso; el modo auditor muestra el rol y el modelo." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="355" y="560" width="270" height="95" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Regla de viabilidad&lt;/b&gt; (pregunta VIA-E1)&lt;br&gt;✅ viable: consenso y mediana ≥ 4&lt;br&gt;⚠️ con condiciones: consenso y mediana ≥ 3&lt;br&gt;⛔ no viable: consenso y mediana &amp;lt; 3&lt;br&gt;❓ en discusión: sin consenso" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="975" y="1010" width="270" height="115" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Regla de cada decisión&lt;/b&gt;&lt;br&gt;✅ firme: consenso, nota ≥ 4 y 1 punto sobre la segunda&lt;br&gt;⚠️ condicionada: consenso, pero ventaja chica o nota 3&lt;br&gt;❓ abierta: sin consenso → prueba de concepto" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1285" y="1010" width="270" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hoja3" name="3 · Una ronda por dentro"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:22px'&gt;3 · Una ronda por dentro: cómo trabajan el Moderador y los expertos (CrewAI)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Por cada experto se arma un equipo CrewAI propio con el Moderador como jefe (Process.hierarchical). Todos corren en paralelo.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1640" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Motor (código)&lt;/b&gt;&lt;br&gt;arma el enunciado de cada experto y lo revisa con &lt;b&gt;guard_independencia&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="360" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Qué recibe cada experto&lt;/b&gt;&lt;br&gt;• datos del proyecto&lt;br&gt;• el cuestionario&lt;br&gt;• (ronda 2+) &lt;b&gt;su&lt;/b&gt; respuesta anterior&lt;br&gt;• (ronda 2+) medianas, IQR y argumentos &lt;b&gt;sin autor&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nunca&lt;/b&gt;: quién es cada uno, qué IA usa ni el texto de otro experto" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="360" height="160" as="geometry"/></mxCell><mxCell id="n5" value="Equipo CrewAI de «Arquitectura»" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="380" height="330" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Moderador&lt;/b&gt; (manager_agent)&lt;br&gt;decide &lt;b&gt;cuándo&lt;/b&gt; delegar; solo escribe «Responder el cuestionario asignado»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="340" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Experto Arquitectura&lt;/b&gt; (ExpertoDelphi)&lt;br&gt;descarta el texto del Moderador y responde su &lt;b&gt;enunciado sellado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="340" height="70" as="geometry"/></mxCell><mxCell id="e8" value="delega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="respuesta JSON: nota 1-5 y justificación por pregunta + riesgos" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=12;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="340" height="60" as="geometry"/></mxCell><mxCell id="e10" value="se toma directo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="un equipo por experto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="Equipo CrewAI de «Cloud»" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="380" height="330" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Moderador&lt;/b&gt; (manager_agent)&lt;br&gt;decide &lt;b&gt;cuándo&lt;/b&gt; delegar; solo escribe «Responder el cuestionario asignado»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="340" height="70" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Experto Cloud&lt;/b&gt; (ExpertoDelphi)&lt;br&gt;descarta el texto del Moderador y responde su &lt;b&gt;enunciado sellado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="890" y="250" width="340" height="70" as="geometry"/></mxCell><mxCell id="e15" value="delega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="respuesta JSON: nota 1-5 y justificación por pregunta + riesgos" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=12;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="890" y="350" width="340" height="60" as="geometry"/></mxCell><mxCell id="e17" value="se toma directo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="Equipo CrewAI de «Desarrollo»" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="380" height="330" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Moderador&lt;/b&gt; (manager_agent)&lt;br&gt;decide &lt;b&gt;cuándo&lt;/b&gt; delegar; solo escribe «Responder el cuestionario asignado»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="340" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Experto Desarrollo&lt;/b&gt; (ExpertoDelphi)&lt;br&gt;descarta el texto del Moderador y responde su &lt;b&gt;enunciado sellado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="340" height="70" as="geometry"/></mxCell><mxCell id="e21" value="delega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="respuesta JSON: nota 1-5 y justificación por pregunta + riesgos" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=12;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1290" y="350" width="340" height="60" as="geometry"/></mxCell><mxCell id="e23" value="se toma directo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="… y así con cada experto del panel (5 a 7), todos al mismo tiempo" style="text;html=1;align=center;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="470" y="440" width="1180" height="25" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;1. Validación&lt;/b&gt; (código)&lt;br&gt;¿JSON válido y con &lt;b&gt;todas&lt;/b&gt; las preguntas una vez? Si no, 1 reintento con el error; si sigue mal, otro modelo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="490" width="360" height="100" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;2. Agregación&lt;/b&gt; (código)&lt;br&gt;mediana, Q1, Q3, IQR y consenso por pregunta (stats.py); argumentos por tema y sin autor (anonymizer.py)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="380" height="100" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;3. ¿Otra ronda?&lt;/b&gt; (código)&lt;br&gt;consenso, estabilidad y mínimo/máximo de rondas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1290" y="490" width="360" height="100" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="n9" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="n16" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="n22" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;¿Por qué un equipo por experto?&lt;/b&gt;&lt;br&gt;Con uno solo, el Moderador acumularía todas las respuestas en su memoria y superaría el límite de los planes gratuitos. Además, así responden en paralelo." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="390" height="110" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;¿Por qué el enunciado va sellado?&lt;/b&gt;&lt;br&gt;Si el Moderador lo reescribiera, podría resumirlo mal o colar la opinión de otro experto. Eso rompería la independencia que exige Delphi." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="640" width="390" height="110" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;¿Por qué la respuesta se toma directo?&lt;/b&gt;&lt;br&gt;En CrewAI, el resultado de la tarea es lo que dice el jefe (el Moderador), que podría cambiar una nota. Se usa lo que escribió el experto." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="390" height="110" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;¿Y las herramientas (tools)?&lt;/b&gt;&lt;br&gt;CrewAI no permite que el jefe tenga herramientas. Por eso la estadística y la anonimización las llama el código; además, así los números son exactos." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1270" y="640" width="390" height="110" as="geometry"/></mxCell><mxCell id="n37" value="Configuración de cada tarea: &lt;b&gt;context=[]&lt;/b&gt; (no ve tareas anteriores) · sin memoria · sin delegación entre expertos · &lt;b&gt;max_iter&lt;/b&gt; acotado" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1610" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hoja4" name="4 · Componentes y responsables"><mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:22px'&gt;4 · Componentes y responsables&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Los módulos del repositorio, por capa. El color indica quién es responsable según el README.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1640" height="60" as="geometry"/></mxCell><mxCell id="n3" value="Juan · plataforma" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="25" width="130" height="28" as="geometry"/></mxCell><mxCell id="n4" value="Pamela · motor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="25" width="120" height="28" as="geometry"/></mxCell><mxCell id="n5" value="Jenaro · panel y frontend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1370" y="25" width="170" height="28" as="geometry"/></mxCell><mxCell id="n6" value="externo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1550" y="25" width="90" height="28" as="geometry"/></mxCell><mxCell id="n7" value="FRONTEND · frontend/" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;opacity=55;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1060" height="170" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;app.py · ui.py&lt;/b&gt;&lt;br&gt;navegación, veredicto, decisiones, riesgos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="45" y="130" width="198" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;pages/1_Nuevo.py&lt;/b&gt;&lt;br&gt;proyecto, panel, modelos, reglas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="253" y="130" width="198" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;pages/2_En_vivo.py&lt;/b&gt;&lt;br&gt;rondas en vivo, auditor, cancelar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="461" y="130" width="198" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;pages/3 y 4&lt;/b&gt;&lt;br&gt;resultados, historial y comparación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="669" y="130" width="198" height="110" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;api_client.py · mocks/&lt;/b&gt;&lt;br&gt;API real o datos de demo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="877" y="130" width="198" height="110" as="geometry"/></mxCell><mxCell id="n13" value="CLIENTES" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=3;